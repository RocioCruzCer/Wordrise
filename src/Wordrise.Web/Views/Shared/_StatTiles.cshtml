@model UserStats
<ul class="stats" aria-label="Your stats">
    <li class="stat"><span class="bubble" aria-hidden="true">@await Html.PartialAsync("_Icon", "book")</span><strong>@Model.WordsLearned</strong><span>Words learned</span></li>
    <li class="stat"><span class="bubble green" aria-hidden="true">@await Html.PartialAsync("_Icon", "target")</span><strong>@Model.AccuracyPercent%</strong><span>Accuracy</span></li>
    <li class="stat"><span class="bubble night" aria-hidden="true">@await Html.PartialAsync("_Icon", "bolt")</span><strong>@Model.AverageAttempts.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</strong><span>Avg. attempts</span></li>
    <li class="stat"><span class="bubble coral" aria-hidden="true">@await Html.PartialAsync("_Icon", "history")</span><strong>@Model.ToReview</strong><span>To review</span></li>
</ul>
