@model string
@* Minimal stroke icons (decorative). *@
<svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "home":
            <text><path d="M3 11l9-7 9 7" /><path d="M5 10v10h14V10" /></text>
            break;
        case "play":
            <text><circle cx="12" cy="12" r="9" /><path d="M10 8l6 4-6 4z" /></text>
            break;
        case "progress":
            <text><path d="M4 20V10" /><path d="M10 20V4" /><path d="M16 20v-7" /><path d="M22 20H2" /></text>
            break;
        case "profile":
            <text><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></text>
            break;
        case "speaker":
            <text><path d="M4 9v6h4l5 4V5L8 9z" /><path d="M16 9a4 4 0 010 6" /><path d="M19 6a8 8 0 010 12" /></text>
            break;
        case "check":
            <text><path d="M5 12l5 5 9-10" /></text>
            break;
        case "trophy":
            <text><path d="M8 4h8v5a4 4 0 01-8 0z" /><path d="M8 6H5a3 3 0 003 4" /><path d="M16 6h3a3 3 0 01-3 4" /><path d="M12 13v4" /><path d="M8 20h8" /></text>
            break;
        case "lock":
            <text><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 018 0v4" /></text>
            break;
        case "flame":
            <text><path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 01-10 0c0-2.2 1-3.7 2.2-4.8.2 1.6 1 2.6 2 2.8-.6-2.6-.2-5.4.8-8z" /></text>
            break;
        case "bolt":
            <text><path d="M13 2L4 14h7l-1 8 9-12h-7z" /></text>
            break;
        case "shield":
            <text><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z" /><path d="M9 12l2 2 4-4" /></text>
            break;
        case "target":
            <text><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" /></text>
            break;
        case "shuffle":
            <text><path d="M16 3h5v5" /><path d="M4 20L21 3" /><path d="M21 16v5h-5" /><path d="M15 15l6 6" /><path d="M4 4l5 5" /></text>
            break;
        case "history":
            <text><path d="M3 12a9 9 0 103-6.7L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l3 2" /></text>
            break;
        case "headphones":
            <text><path d="M4 15v-3a8 8 0 0116 0v3" /><rect x="3" y="14" width="5" height="7" rx="2" /><rect x="16" y="14" width="5" height="7" rx="2" /></text>
            break;
        case "book":
            <text><path d="M4 5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z" /><path d="M4 19V5" /><path d="M9 7h6" /></text>
            break;
        case "star":
            <text><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" /></text>
            break;
    }
</svg>
